{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentcopilot.local/schemas/agent-contract/core-analysis-artifacts.schema.json",
  "title": "Core Tender Analysis Artifacts v2",
  "type": "object",
  "allOf": [
    {"$ref": "artifact-envelope.schema.json"},
    {"oneOf": [
      {"$ref": "#/$defs/tenderStructureArtifact"},
      {"$ref": "#/$defs/requirementSetArtifact"},
      {"$ref": "#/$defs/disqualificationRegisterArtifact"},
      {"$ref": "#/$defs/evaluationMatrixArtifact"},
      {"$ref": "#/$defs/clarificationRegisterArtifact"},
      {"$ref": "#/$defs/analysisDiffArtifact"}
    ]}
  ],
  "$defs": {
    "evidenceRef": {"$ref": "artifact-envelope.schema.json#/$defs/evidenceItemRef"},
    "decisionRef": {"allOf": [{"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, {"type": "object", "properties": {"artifact_type": {"const": "user_decision"}}}]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kinds", "assertion_status", "method"],
      "properties": {
        "source_kinds": {"type": "array", "items": {"type": "string", "enum": ["source_document", "user_supplement", "user_decision", "system_derived", "model_inference"]}, "minItems": 1, "uniqueItems": true},
        "assertion_status": {"type": "string", "enum": ["proposed", "confirmed", "unknown", "conflicting"]},
        "method": {"type": "string", "enum": ["deterministic", "llm", "hybrid", "user_entered"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {"if": {"properties": {"assertion_status": {"enum": ["unknown", "conflicting"]}}}, "then": {"not": {"required": ["confidence"]}}},
        {"if": {"properties": {"method": {"enum": ["deterministic", "user_entered"]}}}, "then": {"not": {"required": ["confidence"]}}}
      ]
    },
    "commonConclusion": {
      "type": "object",
      "required": ["evidence_refs", "provenance", "resolution_status", "decision_refs"],
      "properties": {
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "unknown_basis": {"type": "string", "enum": ["not_in_scope", "parse_unavailable", "analysis_failed", "insufficient_evidence"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "resolution_status": {"type": "string", "enum": ["unresolved", "resolved", "not_applicable"]},
        "decision_refs": {"type": "array", "items": {"$ref": "#/$defs/decisionRef"}}
      }
    },
    "analysisMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_status", "available_topics", "failed_topics"],
      "properties": {
        "analysis_status": {"$ref": "artifact-envelope.schema.json#/$defs/analysisStatus"},
        "run_ref": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"},
        "available_topics": {"type": "array", "items": {"type": "string"}},
        "failed_topics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverageObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_state", "profile", "supported_claim_strength", "basis_bundle_refs", "limitations"],
      "properties": {
        "assessment_state": {"type": "string", "enum": ["not_checked", "partial", "completed", "blocked"]},
        "profile": {"type": "string", "enum": ["candidate_retrieval", "targeted_scan", "documented_completed_scope", "full_scan_with_backcheck", "user_provided_only"]},
        "supported_claim_strength": {"type": "string", "enum": ["no_completeness_claim", "checked_scope_only", "complete_for_declared_scope"]},
        "basis_bundle_refs": {"type": "array", "items": {"$ref": "artifact-envelope.schema.json#/$defs/evidenceBundleRef"}, "minItems": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"assessment_state": {"enum": ["not_checked", "partial", "blocked"]}}}, "then": {"properties": {"supported_claim_strength": {"enum": ["no_completeness_claim", "checked_scope_only"]}}}}]
    },
    "sourcedTextValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_status", "evidence_refs", "provenance", "resolution_status", "decision_refs"],
      "properties": {"value_status": {"type": "string", "enum": ["confirmed", "unknown", "conflicting", "not_applicable"]}, "value": {"type": "string"}, "raw_expression": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}, "unknown_basis": {"type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}, "resolution_status": {"type": "string", "enum": ["unresolved", "resolved", "not_applicable"]}, "decision_refs": {"type": "array", "items": {"$ref": "#/$defs/decisionRef"}}}
    },
    "tenderStructureArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "tender_structure"}, "payload": {"$ref": "#/$defs/tenderStructurePayload"}}},
    "tenderStructurePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["structure_id", "analysis", "facts", "tender_scope", "segments", "document_relationships", "unresolved_fact_ids", "coverage_observation"],
      "properties": {
        "structure_id": {"type": "string", "pattern": "^structure_"}, "analysis": {"$ref": "#/$defs/analysisMetadata"}, "facts": {"type": "array", "items": {"$ref": "#/$defs/structureFact"}},
        "tender_scope": {"type": "object", "additionalProperties": false, "required": ["response_mode", "submission_unit"], "properties": {"procurement_method": {"$ref": "#/$defs/sourcedTextValue"}, "bidder_entity_label": {"$ref": "#/$defs/sourcedTextValue"}, "response_mode": {"type": "string", "enum": ["single_submission", "per_lot", "per_package", "unknown", "conflicting"]}, "submission_unit": {"type": "string", "enum": ["project", "package", "lot", "volume", "other", "unknown"]}}},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/tenderSegment"}}, "document_relationships": {"type": "array", "items": {"$ref": "#/$defs/documentRelationship"}}, "unresolved_fact_ids": {"type": "array", "items": {"type": "string"}}, "coverage_observation": {"$ref": "#/$defs/coverageObservation"}
      }
    },
    "structureFact": {"allOf": [{"$ref": "#/$defs/commonConclusion"}, {"type": "object", "additionalProperties": false, "required": ["item_id", "field", "field_label", "value", "value_status", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"item_id": {"type": "string", "pattern": "^fact_"}, "field": {"type": "string", "enum": ["project_name", "project_code", "purchaser", "procurer", "agency", "procurement_method", "bidder_entity_label", "response_mode", "submission_unit", "submission_deadline", "opening_time", "clarification_deadline", "acquisition_deadline", "guarantee_deadline", "bid_validity_period", "submission_channel", "currency", "segment", "attachment", "other"]}, "field_label": {"type": "string"}, "value": {"type": "string"}, "value_status": {"type": "string", "enum": ["confirmed", "unknown", "conflicting", "not_applicable"]}, "evidence_refs": {}, "unknown_basis": {}, "provenance": {}, "resolution_status": {}, "decision_refs": {}}}]},
    "tenderSegment": {"allOf": [{"$ref": "#/$defs/commonConclusion"}, {"type": "object", "additionalProperties": false, "required": ["segment_id", "identifier", "label", "segment_kind", "submission_scope", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"segment_id": {"type": "string", "pattern": "^seg_"}, "identifier": {"$ref": "#/$defs/sourcedTextValue"}, "label": {"type": "string"}, "segment_kind": {"type": "string", "enum": ["package", "lot", "volume", "section", "other"]}, "parent_segment_id": {"type": "string"}, "submission_scope": {"type": "string", "enum": ["separate_response", "combined_response", "unknown", "conflicting"]}, "applicability_rule": {"type": "string"}, "source_document_refs": {"type": "array", "items": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}}, "evidence_refs": {}, "provenance": {}, "resolution_status": {}, "decision_refs": {}}}]},
    "documentRelationship": {"type": "object", "additionalProperties": false, "required": ["relationship_id", "kind", "from_source_ref", "to_source_ref", "status", "evidence_refs", "decision_refs"], "properties": {"relationship_id": {"type": "string", "pattern": "^rel_"}, "kind": {"type": "string", "enum": ["amends", "clarifies", "attaches_to", "supersedes", "references", "unknown"]}, "from_source_ref": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, "to_source_ref": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, "status": {"type": "string", "enum": ["proposed", "confirmed", "conflicting"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}, "decision_refs": {"type": "array", "items": {"$ref": "#/$defs/decisionRef"}}}},
    "requirementSetArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "requirement_set"}, "payload": {"$ref": "#/$defs/requirementSetPayload"}}},
    "requirementSetPayload": {"type": "object", "additionalProperties": false, "required": ["set_id", "purpose", "analysis", "items", "unresolved_item_ids", "coverage_observation"], "properties": {"set_id": {"type": "string", "pattern": "^reqset_"}, "purpose": {"type": "string", "enum": ["qualification", "submission", "business_technical", "combined"]}, "analysis": {"$ref": "#/$defs/analysisMetadata"}, "items": {"type": "array", "items": {"$ref": "#/$defs/requirementItem"}}, "unresolved_item_ids": {"type": "array", "items": {"type": "string"}}, "coverage_observation": {"$ref": "#/$defs/coverageObservation"}}},
    "requirementItem": {"allOf": [{"$ref": "#/$defs/commonConclusion"}, {"type": "object", "additionalProperties": false, "required": ["item_id", "category", "title", "statement", "mandatory_level", "applicability", "requirement_kind", "response_expectation", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"item_id": {"type": "string", "pattern": "^req_"}, "category": {"type": "string", "enum": ["qualification", "submission", "format", "commercial", "technical", "service", "legal", "administrative", "other"]}, "title": {"type": "string"}, "statement": {"type": "string"}, "subject_role": {"type": "string"}, "scope_segment_refs": {"type": "array", "items": {"type": "string"}}, "mandatory_level": {"type": "string", "enum": ["mandatory", "conditional", "optional", "unknown"]}, "applicability": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"type": "string", "enum": ["applies", "conditional", "unknown", "not_applicable"]}, "condition": {"type": "string"}}}, "requirement_kind": {"type": "string"}, "response_expectation": {"type": "string"}, "raw_expression": {"type": "string"}, "constraint": {"type": "object"}, "related_item_refs": {"type": "array", "items": {"$ref": "artifact-envelope.schema.json#/$defs/itemRef"}}, "evidence_refs": {}, "unknown_basis": {}, "provenance": {}, "resolution_status": {}, "decision_refs": {}}}]},
    "disqualificationRegisterArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "disqualification_register"}, "payload": {"$ref": "#/$defs/disqualificationRegisterPayload"}}},
    "disqualificationRegisterPayload": {"type": "object", "additionalProperties": false, "required": ["register_id", "finding_state", "analysis", "items", "coverage_observation", "unresolved_item_ids"], "properties": {"register_id": {"type": "string", "pattern": "^dqreg_"}, "finding_state": {"type": "string", "enum": ["items_present", "none_found_in_checked_scope", "inconclusive"]}, "analysis": {"$ref": "#/$defs/analysisMetadata"}, "items": {"type": "array", "items": {"$ref": "#/$defs/disqualificationItem"}}, "coverage_observation": {"$ref": "#/$defs/coverageObservation"}, "unresolved_item_ids": {"type": "array", "items": {"type": "string"}}}},
    "disqualificationItem": {"allOf": [{"$ref": "#/$defs/commonConclusion"}, {"type": "object", "additionalProperties": false, "required": ["item_id", "title", "trigger", "consequence", "scope", "severity", "conditions", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"item_id": {"type": "string", "pattern": "^dq_"}, "title": {"type": "string"}, "trigger": {"type": "string"}, "consequence": {"type": "string", "enum": ["invalid_bid", "rejected", "disqualified", "not_accepted", "other_explicit_consequence", "unclear"]}, "scope": {"type": "string"}, "severity": {"type": "string", "enum": ["critical", "high", "medium", "unknown"]}, "conditions": {"type": "array", "items": {"type": "string"}}, "mitigation_hint": {"type": "string"}, "related_item_refs": {"type": "array", "items": {"$ref": "artifact-envelope.schema.json#/$defs/itemRef"}}, "evidence_refs": {}, "unknown_basis": {}, "provenance": {}, "resolution_status": {}, "decision_refs": {}}}]},
    "evaluationMatrixArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "evaluation_matrix"}, "payload": {"$ref": "#/$defs/evaluationMatrixPayload"}}},
    "evaluationMatrixPayload": {"type": "object", "additionalProperties": false, "required": ["matrix_id", "analysis", "evaluation_method", "total_score", "items", "unresolved_item_ids", "coverage_observation"], "properties": {"matrix_id": {"type": "string", "pattern": "^eval_"}, "analysis": {"$ref": "#/$defs/analysisMetadata"}, "evaluation_method": {"$ref": "#/$defs/sourcedTextValue"}, "total_score": {"$ref": "#/$defs/scoringValue"}, "items": {"type": "array", "items": {"$ref": "#/$defs/evaluationItem"}}, "unresolved_item_ids": {"type": "array", "items": {"type": "string"}}, "coverage_observation": {"$ref": "#/$defs/coverageObservation"}}},
    "scoringValue": {"oneOf": [{"$ref": "#/$defs/numericScore"}, {"$ref": "#/$defs/rangeScore"}, {"$ref": "#/$defs/formulaScore"}, {"$ref": "#/$defs/qualitativeScore"}, {"$ref": "#/$defs/passFailScore"}, {"$ref": "#/$defs/adjustmentScore"}, {"$ref": "#/$defs/unknownScore"}]},
    "scoreBase": {"type": "object", "required": ["kind", "raw_expression", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"kind": {"type": "string"}, "raw_expression": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}, "provenance": {"$ref": "#/$defs/provenance"}, "resolution_status": {"type": "string", "enum": ["unresolved", "resolved", "not_applicable"]}, "decision_refs": {"type": "array", "items": {"$ref": "#/$defs/decisionRef"}}, "table_lineage": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "numericScore": {"allOf": [{"$ref": "#/$defs/scoreBase"}, {"type": "object", "required": ["kind", "value", "unit"], "properties": {"kind": {"const": "numeric"}, "value": {"type": "number"}, "unit": {"type": "string"}}}]},
    "rangeScore": {"allOf": [{"$ref": "#/$defs/scoreBase"}, {"type": "object", "required": ["kind", "minimum", "maximum", "unit"], "properties": {"kind": {"const": "range"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "unit": {"type": "string"}}}]},
    "formulaScore": {"allOf": [{"$ref": "#/$defs/scoreBase"}, {"type": "object", "required": ["kind", "expression", "output_unit"], "properties": {"kind": {"const": "formula"}, "expression": {"type": "string"}, "output_unit": {"type": "string"}, "variables": {"type": "array", "items": {"type": "string"}}}}]},
    "qualitativeScore": {"allOf": [{"$ref": "#/$defs/scoreBase"}, {"type": "object", "required": ["kind", "levels"], "properties": {"kind": {"const": "qualitative"}, "levels": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}]},
    "passFailScore": {"allOf": [{"$ref": "#/$defs/scoreBase"}, {"type": "object", "required": ["kind", "pass_effect"], "properties": {"kind": {"const": "pass_fail"}, "pass_effect": {"type": "string"}}}]},
    "adjustmentScore": {"allOf": [{"$ref": "#/$defs/scoreBase"}, {"type": "object", "required": ["kind", "direction", "value", "unit"], "properties": {"kind": {"const": "signed_adjustment"}, "direction": {"type": "string", "enum": ["bonus", "penalty"]}, "value": {"type": "number"}, "unit": {"type": "string"}}}]},
    "unknownScore": {"type": "object", "additionalProperties": false, "required": ["kind", "value_status", "raw_expression", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"kind": {"const": "unknown"}, "value_status": {"type": "string", "enum": ["unknown", "conflicting", "not_applicable"]}, "raw_expression": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}, "provenance": {"$ref": "#/$defs/provenance"}, "resolution_status": {"type": "string"}, "decision_refs": {"type": "array", "items": {"$ref": "#/$defs/decisionRef"}}, "unknown_basis": {"type": "string"}}},
    "evaluationItem": {"allOf": [{"$ref": "#/$defs/commonConclusion"}, {"type": "object", "additionalProperties": false, "required": ["item_id", "criterion", "score", "scoring_rules", "response_alignment_hint", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"item_id": {"type": "string", "pattern": "^score_"}, "criterion": {"type": "string"}, "score": {"$ref": "#/$defs/scoringValue"}, "scoring_rules": {"type": "array", "items": {"$ref": "#/$defs/scoringRule"}}, "evidence_expectation": {"type": "string"}, "response_alignment_hint": {"type": "string"}, "related_item_refs": {"type": "array", "items": {"$ref": "artifact-envelope.schema.json#/$defs/itemRef"}}, "evidence_refs": {}, "unknown_basis": {}, "provenance": {}, "resolution_status": {}, "decision_refs": {}}}]},
    "scoringRule": {"allOf": [{"$ref": "#/$defs/commonConclusion"}, {"type": "object", "additionalProperties": false, "required": ["rule_id", "criterion_statement", "score_effect", "evidence_refs", "provenance", "resolution_status", "decision_refs"], "properties": {"rule_id": {"type": "string", "pattern": "^scorerule_"}, "criterion_statement": {"type": "string"}, "score_effect": {"$ref": "#/$defs/scoringValue"}, "evidence_expectation": {"type": "string"}, "evidence_refs": {}, "provenance": {}, "resolution_status": {}, "decision_refs": {}}}]},
    "clarificationRegisterArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "clarification_register"}, "payload": {"$ref": "#/$defs/clarificationRegisterPayload"}}},
    "clarificationRegisterPayload": {"type": "object", "additionalProperties": false, "required": ["register_id", "analysis", "assessment_state", "coverage_observation", "items"], "properties": {"register_id": {"type": "string", "pattern": "^clarreg_"}, "analysis": {"$ref": "#/$defs/analysisMetadata"}, "assessment_state": {"type": "string", "enum": ["not_checked", "partial", "completed", "blocked"]}, "coverage_observation": {"$ref": "#/$defs/coverageObservation"}, "items": {"type": "array", "items": {"$ref": "#/$defs/clarificationItem"}}}},
    "clarificationItem": {"type": "object", "additionalProperties": false, "required": ["item_id", "issue_type", "title", "description", "severity", "affected_artifact_refs", "related_evidence_refs", "recommended_action", "resolution_status", "decision_refs"], "properties": {"item_id": {"type": "string", "pattern": "^clar_"}, "issue_type": {"type": "string", "enum": ["conflict", "ambiguity", "missing_attachment", "parse_quality", "evidence_gap", "scope", "other"]}, "title": {"type": "string"}, "description": {"type": "string"}, "severity": {"type": "string", "enum": ["blocking", "high", "medium", "low"]}, "affected_artifact_refs": {"type": "array", "items": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}}, "related_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}, "source_document_ref": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, "parse_result_ref": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, "impact_scope": {"type": "array", "items": {"type": "string"}}, "recommended_action": {"type": "string"}, "resolution_status": {"type": "string", "enum": ["unresolved", "resolved", "not_applicable"]}, "decision_refs": {"type": "array", "items": {"$ref": "#/$defs/decisionRef"}}}},
    "analysisDiffArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "analysis_diff"}, "payload": {"$ref": "#/$defs/analysisDiffPayload"}}},
    "analysisDiffPayload": {"type": "object", "additionalProperties": false, "required": ["diff_id", "comparison_basis", "base_ref", "target_ref", "change_summary", "item_changes", "impact_assessment"], "properties": {"diff_id": {"type": "string", "pattern": "^diff_"}, "comparison_basis": {"type": "string", "enum": ["revision_to_revision", "candidate_to_approved", "user_edit_application", "reanalysis_after_source_change"]}, "base_ref": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, "target_ref": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, "change_summary": {"type": "object", "additionalProperties": false, "required": ["added", "removed", "modified", "unchanged"], "properties": {"added": {"type": "integer", "minimum": 0}, "removed": {"type": "integer", "minimum": 0}, "modified": {"type": "integer", "minimum": 0}, "unchanged": {"type": "integer", "minimum": 0}}}, "item_changes": {"type": "array", "items": {"$ref": "#/$defs/itemChange"}}, "impact_assessment": {"type": "object", "additionalProperties": false, "required": ["affected_artifact_refs", "refresh_required", "publication_blocked", "reasons"], "properties": {"affected_artifact_refs": {"type": "array", "items": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}}, "refresh_required": {"type": "boolean"}, "publication_blocked": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}}}}},
    "itemChange": {"type": "object", "additionalProperties": false, "required": ["change_id", "change_kind", "base_item_ids", "target_item_ids", "field_changes", "evidence_changed", "semantic_impact"], "properties": {"change_id": {"type": "string", "pattern": "^chgitem_"}, "change_kind": {"type": "string", "enum": ["added", "removed", "modified", "unchanged", "split", "merged", "reidentified"]}, "base_item_ids": {"type": "array", "items": {"type": "string"}}, "target_item_ids": {"type": "array", "items": {"type": "string"}}, "lineage": {"type": "object", "additionalProperties": false, "required": ["relation", "basis", "review_status"], "properties": {"relation": {"type": "string", "enum": ["same", "split_from", "merged_from", "replaced_by", "reidentified"]}, "basis": {"type": "string", "enum": ["deterministic_id", "deterministic_content", "reviewed_match"]}, "review_status": {"type": "string", "enum": ["not_needed", "recommended", "required"]}}}, "field_changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "before_summary", "after_summary"], "properties": {"path": {"type": "string", "pattern": "^/"}, "before_summary": {"type": "string"}, "after_summary": {"type": "string"}}}}, "evidence_changed": {"type": "boolean"}, "semantic_impact": {"type": "string", "enum": ["none", "review_recommended", "requires_baseline_review", "blocks_publication"]}}}
  }
}
