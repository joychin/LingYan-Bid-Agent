{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentcopilot.local/schemas/agent-contract/planning-publication-artifacts.schema.json",
  "title": "Planning and Publication Boundary Artifacts v2",
  "type": "object",
  "allOf": [
    {"$ref": "artifact-envelope.schema.json"},
    {"oneOf": [
      {"$ref": "#/$defs/responseFilePlanCandidateArtifact"},
      {"$ref": "#/$defs/tenderBaselineArtifact"},
      {"$ref": "#/$defs/outlineCandidateArtifact"},
      {"$ref": "#/$defs/changeSetArtifact"},
      {"$ref": "#/$defs/outlinePublicationArtifact"},
      {"$ref": "#/$defs/exportSnapshotArtifact"}
    ]}
  ],
  "$defs": {
    "artifactRef": {"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"},
    "itemRef": {"$ref": "artifact-envelope.schema.json#/$defs/itemRef"},
    "approvalRef": {"allOf": [{"$ref": "artifact-envelope.schema.json#/$defs/artifactRef"}, {"type": "object", "properties": {"artifact_type": {"const": "user_decision"}}}]},
    "thinOutputRef": {"type": "object", "additionalProperties": false, "required": ["storage_ref", "content_hash", "format"], "properties": {"storage_ref": {"type": "string", "minLength": 1}, "content_hash": {"$ref": "artifact-envelope.schema.json#/$defs/hash"}, "format": {"type": "string", "minLength": 1}, "node_count": {"type": "integer", "minimum": 0}}},
    "responseFilePlanCandidateArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "response_file_plan_candidate"}, "payload": {"$ref": "#/$defs/responseFilePlanCandidatePayload"}}},
    "responseFilePlanCandidatePayload": {"type": "object", "additionalProperties": false, "required": ["plan_id", "analysis_refs", "items", "delivery_constraints", "status"], "properties": {"plan_id": {"type": "string", "pattern": "^rfplan_"}, "analysis_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}, "minItems": 1}, "items": {"type": "array", "items": {"$ref": "#/$defs/planItem"}, "minItems": 1}, "delivery_constraints": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "source_refs"], "properties": {"statement": {"type": "string"}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/itemRef"}}}}}, "status": {"type": "string", "enum": ["proposed", "partial", "blocked"]}}},
    "planItem": {"type": "object", "additionalProperties": false, "required": ["plan_item_id", "logical_name", "response_kind", "source_refs", "information_needed", "status"], "properties": {"plan_item_id": {"type": "string", "pattern": "^rfplanitem_"}, "logical_name": {"type": "string", "minLength": 1}, "response_kind": {"type": "string", "enum": ["technical", "commercial", "qualification", "submission", "other"]}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/itemRef"}}, "information_needed": {"type": "array", "items": {"type": "string"}}, "delivery_metadata": {"type": "object"}, "status": {"type": "string", "enum": ["proposed", "selected", "rejected", "unknown"]}}},
    "tenderBaselineArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "tender_baseline"}, "payload": {"$ref": "#/$defs/tenderBaselinePayload"}}},
    "tenderBaselinePayload": {"type": "object", "additionalProperties": false, "required": ["baseline_id", "selected_analysis_refs", "source_set_ref", "selected_plan_ref", "blocking_clarification_refs", "approval_ref"], "properties": {"baseline_id": {"type": "string", "pattern": "^baseline_"}, "selected_analysis_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}, "minItems": 1}, "source_set_ref": {"$ref": "#/$defs/artifactRef"}, "selected_plan_ref": {"$ref": "#/$defs/artifactRef"}, "blocking_clarification_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}, "approval_ref": {"$ref": "#/$defs/approvalRef"}, "selection_notes": {"type": "array", "items": {"type": "string"}}}},
    "outlineCandidateArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "outline_candidate"}, "payload": {"$ref": "#/$defs/outlineCandidatePayload"}}},
    "outlineCandidatePayload": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "baseline_ref", "plan_item_ref", "outline_representation", "coverage_input_refs", "generation_run_ref", "status"], "properties": {"candidate_id": {"type": "string", "pattern": "^outlinecand_"}, "baseline_ref": {"$ref": "#/$defs/artifactRef"}, "plan_item_ref": {"$ref": "#/$defs/itemRef"}, "outline_representation": {"$ref": "#/$defs/thinOutputRef"}, "coverage_input_refs": {"type": "array", "items": {"$ref": "#/$defs/itemRef"}}, "generation_run_ref": {"$ref": "#/$defs/artifactRef"}, "status": {"type": "string", "enum": ["complete", "partial", "blocked"]}, "information_needed": {"type": "array", "items": {"type": "string"}}}},
    "changeSetArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "change_set"}, "payload": {"$ref": "#/$defs/changeSetPayload"}}},
    "changeSetPayload": {"type": "object", "additionalProperties": false, "required": ["change_set_id", "kind", "base_selection", "proposed_selection", "diff_refs", "dependency_impact", "policy_evaluation", "application"], "properties": {"change_set_id": {"type": "string", "pattern": "^chg_"}, "kind": {"type": "string", "enum": ["adopt_baseline", "publish_outline", "export_package", "revise_source_scope"]}, "base_selection": {"type": "array", "items": {"$ref": "#/$defs/selectionSlot"}}, "proposed_selection": {"type": "array", "items": {"$ref": "#/$defs/selectionSlot"}, "minItems": 1}, "diff_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}, "dependency_impact": {"type": "object", "additionalProperties": false, "required": ["affected_refs", "required_reanalysis", "blocking_clarification_refs", "publication_gate"], "properties": {"affected_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}, "required_reanalysis": {"type": "array", "items": {"type": "string"}}, "blocking_clarification_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}, "publication_gate": {"type": "string", "enum": ["pass", "blocked", "approval_required"]}}}, "policy_evaluation": {"type": "object", "additionalProperties": false, "required": ["policy_version", "outcome", "reasons"], "properties": {"policy_version": {"type": "string"}, "outcome": {"type": "string", "enum": ["approval_required", "auto_applicable", "denied"]}, "reasons": {"type": "array", "items": {"type": "string"}}}}, "approval_ref": {"$ref": "#/$defs/approvalRef"}, "application": {"type": "object", "additionalProperties": false, "required": ["state", "resulting_refs"], "properties": {"state": {"type": "string", "enum": ["proposed", "approved", "rejected", "applied", "failed"]}, "applied_at": {"$ref": "artifact-envelope.schema.json#/$defs/utcTimestamp"}, "resulting_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}}}}},
    "selectionSlot": {"type": "object", "additionalProperties": false, "required": ["slot", "ref"], "properties": {"slot": {"type": "string", "enum": ["source_set", "approved_baseline", "response_file_plan", "outline_candidate", "approved_outline", "review_report", "export_snapshot"]}, "ref": {"$ref": "#/$defs/artifactRef"}}},
    "outlinePublicationArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "outline_publication"}, "payload": {"$ref": "#/$defs/outlinePublicationPayload"}}},
    "outlinePublicationPayload": {"type": "object", "additionalProperties": false, "required": ["publication_id", "candidate_ref", "change_set_ref", "approved_baseline_ref", "plan_item_ref", "legacy_projection"], "properties": {"publication_id": {"type": "string", "pattern": "^outpub_"}, "candidate_ref": {"$ref": "#/$defs/artifactRef"}, "change_set_ref": {"$ref": "#/$defs/artifactRef"}, "approved_baseline_ref": {"$ref": "#/$defs/artifactRef"}, "plan_item_ref": {"$ref": "#/$defs/itemRef"}, "legacy_projection": {"$ref": "#/$defs/legacyProjection"}}},
    "legacyProjection": {"type": "object", "additionalProperties": false, "required": ["target", "projection_version", "projection_hash", "state"], "properties": {"target": {"type": "string", "minLength": 1}, "projection_version": {"type": "string"}, "projection_hash": {"$ref": "artifact-envelope.schema.json#/$defs/hash"}, "state": {"type": "string", "enum": ["not_requested", "applied", "failed"]}, "external_ids": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"type": "string"}, "id": {"type": "string"}}}}}},
    "exportSnapshotArtifact": {"type": "object", "required": ["artifact_type", "payload"], "properties": {"artifact_type": {"const": "export_snapshot"}, "payload": {"$ref": "#/$defs/exportSnapshotPayload"}}},
    "exportSnapshotPayload": {"type": "object", "additionalProperties": false, "required": ["export_id", "selected_refs", "renderer", "output", "validation_summary_ref"], "properties": {"export_id": {"type": "string", "pattern": "^exp_"}, "selected_refs": {"type": "object", "additionalProperties": false, "required": ["baseline", "response_file_plan", "outline_publications"], "properties": {"baseline": {"$ref": "#/$defs/artifactRef"}, "response_file_plan": {"$ref": "#/$defs/artifactRef"}, "outline_publications": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}}}, "legacy_projection_refs": {"type": "array", "items": {"$ref": "#/$defs/legacyProjection"}}, "renderer": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}, "output": {"type": "object", "additionalProperties": false, "required": ["media_type", "content_hash", "storage_ref"], "properties": {"media_type": {"type": "string"}, "content_hash": {"$ref": "artifact-envelope.schema.json#/$defs/hash"}, "storage_ref": {"type": "string"}}}, "validation_summary_ref": {"$ref": "#/$defs/artifactRef"}}}
  }
}
