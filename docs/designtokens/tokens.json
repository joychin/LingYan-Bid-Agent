{
  "Color": {
    "$extensions": {
      "modes": ["Light", "Dark"]
    },
    "text-primary":   { "Light": "#1A1D21", "Dark": "#E6E8EC" },
    "text-secondary": { "Light": "#5B616B", "Dark": "#9AA1AB" },
    "text-tertiary":  { "Light": "#9AA1AB", "Dark": "#6B7280" },
    "text-disabled":  { "Light": "#C2C5CA", "Dark": "#4B5563" },
    "text-on-color":  { "Light": "#FFFFFF", "Dark": "#1A1D21" },

    "bg-canvas":  { "Light": "#FFFFFF", "Dark": "#1A1D21" },
    "bg-surface": { "Light": "#F6F7F9", "Dark": "#0D0F12" },
    "bg-subtle":  { "Light": "#F0F2F5", "Dark": "#25282E" },
    "bg-inverse": { "Light": "#1A1D21", "Dark": "#FFFFFF" },

    "border-default": { "Light": "#E6E8EC", "Dark": "#2E3238" },

    "brand-primary":       { "Light": "#2563EB", "Dark": "#3B82F6" },
    "brand-primary-hover": { "Light": "#1D4ED8", "Dark": "#60A5FA" },
    "brand-primary-soft":  { "Light": "#DBEAFE", "Dark": "#1E3A8A" },

    "success": { "Light": "#10B981", "Dark": "#34D399" },
    "warning": { "Light": "#F59E0B", "Dark": "#FBBF24" },
    "danger":  { "Light": "#EF4444", "Dark": "#F87171" }
  },

  "Spacing": {
    "space-2":  { "$type": "number", "$value": 2 },
    "space-4":  { "$type": "number", "$value": 4 },
    "space-8":  { "$type": "number", "$value": 8 },
    "space-12": { "$type": "number", "$value": 12 },
    "space-16": { "$type": "number", "$value": 16 },
    "space-24": { "$type": "number", "$value": 24 },
    "space-32": { "$type": "number", "$value": 32 },
    "space-48": { "$type": "number", "$value": 48 }
  },

  "Radius": {
    "radius-4":   { "$type": "number", "$value": 4 },
    "radius-8":   { "$type": "number", "$value": 8 },
    "radius-12":  { "$type": "number", "$value": 12 },
    "radius-full": { "$type": "number", "$value": 9999 }
  },

  "Typography": {
    "font-size-xs":   { "$type": "number", "$value": 12 },
    "font-size-sm":   { "$type": "number", "$value": 13 },
    "font-size-base": { "$type": "number", "$value": 14 },
    "font-size-md":   { "$type": "number", "$value": 16 },
    "font-size-lg":   { "$type": "number", "$value": 18 },
    "font-size-xl":   { "$type": "number", "$value": 20 },
    "font-size-2xl":  { "$type": "number", "$value": 24 },
    "font-size-3xl":  { "$type": "number", "$value": 30 },
    "font-size-4xl":  { "$type": "number", "$value": 40 },

    "font-weight-regular":  { "$type": "number", "$value": 400 },
    "font-weight-medium":   { "$type": "number", "$value": 500 },
    "font-weight-semibold": { "$type": "number", "$value": 600 },
    "font-weight-bold":     { "$type": "number", "$value": 700 },

    "font-family-base": { "$type": "string", "$value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif" },
    "font-family-mono": { "$type": "string", "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" }
  },

  "Shadow": {
    "$extensions": {
      "modes": ["Light", "Dark"]
    },
    "shadow-none": { "Light": "none",                                                                                            "Dark": "none" },
    "shadow-xs":   { "Light": "0 1px 2px rgba(15, 15, 15, 0.04)",                                                                  "Dark": "0 1px 2px rgba(0, 0, 0, 0.30)" },
    "shadow-sm":   { "Light": "0 1px 2px rgba(15, 15, 15, 0.04), 0 1px 3px rgba(15, 15, 15, 0.06)",                              "Dark": "0 1px 2px rgba(0, 0, 0, 0.30), 0 1px 3px rgba(0, 0, 0, 0.40)" },
    "shadow-md":   { "Light": "0 4px 6px rgba(15, 15, 15, 0.06), 0 1px 2px rgba(15, 15, 15, 0.04)",                                "Dark": "0 4px 6px rgba(0, 0, 0, 0.40), 0 1px 2px rgba(0, 0, 0, 0.30)" },
    "shadow-lg":   { "Light": "0 16px 32px -8px rgba(15, 15, 15, 0.16), 0 1px 2px rgba(15, 15, 15, 0.04)",                          "Dark": "0 16px 32px -8px rgba(0, 0, 0, 0.60), 0 1px 2px rgba(0, 0, 0, 0.30)" }
  }
}
