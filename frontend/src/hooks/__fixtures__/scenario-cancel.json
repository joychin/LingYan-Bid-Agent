{
  "name": "用户停止：code=cancelled 中性收敛 + terminalRuns 防复活",
  "events": [
    { "event": "agent.started", "data": { "run_id": "r1", "conversation_id": "c1", "seq": 1 } },
    { "event": "agent.token", "data": { "run_id": "r1", "conversation_id": "c1", "text": "正在做", "seq": 2 } },
    { "event": "agent.error", "data": { "run_id": "r1", "conversation_id": "c1", "error": "任务已停止", "code": "cancelled", "seq": 3 } },
    { "event": "run.state", "data": { "run_id": "r1", "conversation_id": "c1", "status": "running" } },
    { "event": "conversation.renamed", "data": { "conversation_id": "c1", "title": "新标题" } }
  ]
}
