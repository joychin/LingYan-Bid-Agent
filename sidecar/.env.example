# 灵燕智能 sidecar 环境变量（复制为 .env 使用；.env 已被 gitignore）
# 模型 Key 的正式存放位置是应用内设置（写入本机 app.db，明文落盘、与 .env 威胁
# 模型等同）；环境变量只作兜底读取——手动起 sidecar 开发时用，应用内配置优先。

LLM_API_KEY=sk-...                          # 兜底/手动开发用；正式配置走应用内设置页
LLM_BASE_URL=https://api.deepseek.com/v1    # 默认 DeepSeek
LLM_MODEL=deepseek-v4-flash
BAIDU_OCR_API_KEY=                          # 百度云文档解析（PaddleOCR-VL）AK，可选；扫描 PDF/.doc/图片解析
BAIDU_OCR_SECRET_KEY=                       # 百度云 SK，与 AK 成对配置
SIDECAR_TOKEN=                              # 随机 token；设置后所有 /api/* 必须带 Bearer
DATA_DIR=                                   # 数据目录，默认 ./data
