{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "splash"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:window:allow-destroy",
    "opener:allow-reveal-item-in-dir"
  ]
}
