{
  "$schema": "../frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "灵燕智能",
  "version": "0.1.0",
  "identifier": "lingyan.ddmdj.com",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "灵燕智能",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 27 },
        "visible": false
      },
      {
        "label": "splash",
        "title": "灵燕智能",
        "url": "splash.html",
        "width": 420,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost customprotocol: asset:; connect-src 'self' tauri: http://tauri.localhost ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' tauri: http://tauri.localhost asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' tauri:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tender-agent-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
